+      assert.equal(r.status,0,r.stderr);
+      const out=await convertMedia(await readFile(input),'image',{name:'fig',fps:30,seconds:3,start:0,mode:'normal',experimentalMB:1,layout:'stretch'});
+      const meta=analyzeWebP(out.buffer);assert.equal(meta.animated,false);assert.equal(meta.width,512);assert.equal(meta.height,512);assert.ok(out.buffer.length<=100*1024);
