+// Decode a still image once. The secondary encoder only receives a PNG
+// produced locally, not the original untrusted media file.
+async function generateStill(exe,input,out,command,maxBytes,dir){
+  const png=path.join(dir,'still.png');
+  await run(exe,['-hide_banner','-loglevel','error','-y','-filter_threads','2',...inputArgs(input,command.start||0),'-frames:v','1','-an','-vf',`format=rgba,${pixelFilter(command.layout)},format=rgba`,'-f','image2',png]);
+  let last,encoder='libwebp';
+  const cap=command.mode==='normal'?Math.min(maxBytes,100*1024):maxBytes;
+  const profiles=[[85,512],[65,512],[40,512],[20,512],[12,384],[8,256],[5,192]];
+  for(const [q,detail] of profiles){
+    for(const candidate of encoder==='magick'?['magick']:['libwebp','magick']){
+      try{
+        if(candidate==='libwebp'){
+          const vf=detail===512?'format=bgra':`scale=${detail}:${detail}:flags=bilinear,scale=512:512:flags=bilinear,format=bgra`;
+          await run(exe,['-hide_banner','-loglevel','error','-y','-filter_threads','2',...inputArgs(png),'-frames:v','1','-an','-vf',vf,'-c:v','libwebp','-lossless','0','-compression_level','1','-quality',String(q),'-f','webp',out]);
+        }else{
+          await run('magick',['-limit','memory','128MiB','-limit','map','256MiB','-limit','disk','512MiB','-limit','thread','2','png:'+png,...(detail===512?[]:['-resize',`${detail}x${detail}!`,'-resize','512x512!']),'-define','webp:lossless=false','-define','webp:method=1','-quality',String(q),'webp:'+out],{timeout:45000});
+        }
+        const b=await readFile(out),info=analyzeWebP(b);
+        if(info.animated||info.width!==512||info.height!==512)throw Error('O codificador não produziu WebP estático de 512 × 512.');
+        encoder=candidate;last=null;
+        if(b.length<=cap)return {b,encoder};
+        break;
+      }catch(e){last=e;}
+    }
+    // Don't repeat a failed encoder chain across every quality level.
+    if(last)throw last;
+  }
+  const e=Error('Imagem excede o tamanho permitido após otimização.');e.publicMessage='A foto não coube no limite do modo Normal. Tente !fig exp1 ou uma imagem menor.';throw e;
